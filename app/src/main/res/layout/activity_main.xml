<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/math_operation"
        android:layout_width="match_parent"
        android:layout_height="80sp"
        android:textColor="@android:color/white"
        android:gravity="end"
        android:ellipsize="start"
        android:textSize="30sp"
        android:singleLine="true"
        />

    <TextView
        android:id="@+id/result_text"
        android:layout_width="match_parent"
        android:layout_height="100sp"
        android:textColor="@android:color/white"
        android:gravity="end"
        android:ellipsize="end"
        android:textSize="30sp"
        android:singleLine="true"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:layout_weight="1">

            <TextView
                style="@style/NumberButtun"
                android:id="@+id/but_ac"
                android:text="AC"
            />
            <TextView
                style="@style/NumberButtun"
                android:id="@+id/but_open"
                android:text="("
                />
            <TextView
                style="@style/NumberButtun"
                android:id="@+id/but_close"
                android:text=")"
                />
            <TextView
                style="@style/NumberButtun"
                android:id="@+id/but_delen"
                android:text="/"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:layout_weight="1">
            <TextView
                style="@style/ActionButtun"
                android:id="@+id/but_7"
                android:text="7"
                />
            <TextView
                style="@style/ActionButtun"
                android:id="@+id/but_8"
                android:text="8"
                />
            <TextView
                style="@style/ActionButtun"
                android:id="@+id/but_9"
                android:text="9"
                />
            <TextView
                style="@style/NumberButtun"
                android:id="@+id/but_umn"
                android:text="*"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:layout_weight="1">
            <TextView
                style="@style/ActionButtun"
                android:id="@+id/but_4"
                android:text="4"
                />
            <TextView
                style="@style/ActionButtun"
                android:id="@+id/but_5"
                android:text="5"
                />
            <TextView
                style="@style/ActionButtun"
                android:id="@+id/but_6"
                android:text="6"
                />
            <TextView
                style="@style/NumberButtun"
                android:id="@+id/but_minus"
                android:text="--"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:layout_weight="1">
            <TextView
                style="@style/ActionButtun"
                android:id="@+id/but_1"
                android:text="1"
                />
            <TextView
                style="@style/ActionButtun"
                android:id="@+id/but_2"
                android:text="2"
                />
            <TextView
                style="@style/ActionButtun"
                android:id="@+id/but_3"
                android:text="3"
                />
            <TextView
                style="@style/NumberButtun"
                android:id="@+id/but_plus"
                android:text="+"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:layout_weight="1">
            <TextView
                style="@style/ActionButtun"
                android:id="@+id/but_back"
                android:text="Back"
                />
            <TextView
                style="@style/ActionButtun"
                android:id="@+id/but_0"
                android:text="0"
                />
            <TextView
                style="@style/ActionButtun"
                android:id="@+id/but_zap"
                android:text=","
                />
            <TextView
                style="@style/NumberButtun"
                android:id="@+id/but_result"
                android:text="="
                />
        </LinearLayout>


    </LinearLayout>

</LinearLayout>